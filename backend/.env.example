# Assessify AI - Backend Environment Variables Template

# Server Configuration
PORT=5000
NODE_ENV=production

# Supabase PostgreSQL Connection Strings
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DIRECT_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Google Gemini AI SDK Key
GEMINI_API_KEY="your-google-gemini-api-key"

# Clerk Authentication Keys
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Allowed Frontend Production Domain (CORS)
FRONTEND_URL="https://assessify-ai.vercel.app"
